---
import ThemeToggle from "../components/ThemeToggle.astro";
import { supportEmail } from "../config/contact";
import { siteUrl } from "../config/site";

const features = [
    {
        description:
            "Create a clear space for the people who are actually there, with invite-only event participation.",
        number: "01",
        title: "Start with the event",
    },
    {
        description:
            "Share a headline and a few conversation cues so people have a natural reason to approach you.",
        number: "02",
        title: "Make introductions easier",
    },
    {
        description:
            "Use live attendee browsing and spatial discovery to notice relevant people who are visible to you in the event.",
        number: "03",
        title: "Discover in the moment",
    },
];

const steps = [
    "Create or join a professional event.",
    "Choose the profile cues you want to share.",
    "Find your next conversation while you are there.",
];

const appStoreUrl = "https://apps.apple.com/app/id6759931142";
const appStoreQrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=240x240&margin=12&data=${encodeURIComponent(appStoreUrl)}`;
const canonicalUrl = `${siteUrl}/`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta
            name="description"
            content="AReach helps people discover and connect with relevant attendees who choose to be visible at live professional events."
        />
        <meta name="theme-color" content="#07130c" data-theme-color />
        <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png" />
        <link rel="canonical" href={canonicalUrl} />
        <title>AReach · Find your people in the room</title>
        <script is:inline>
            (() => {
                try {
                    const storedTheme =
                        window.localStorage.getItem("areach-theme");
                    document.documentElement.dataset.theme =
                        storedTheme === "light" ? "light" : "dark";
                } catch {
                    document.documentElement.dataset.theme = "dark";
                }
            })();
        </script>
        <style>
            :root {
                color-scheme: dark;
                --accent: #15b95b;
                --accent-bright: #39d878;
                --accent-soft: #65eb95;
                --accent-strong: #65eb95;
                --accent-surface: rgba(15, 177, 79, 0.18);
                --action-text: #06160b;
                --background: #07130c;
                --border: rgba(190, 255, 207, 0.16);
                --border-strong: rgba(190, 255, 207, 0.24);
                --card-shadow: none;
                --cta-accent: #0c7b38;
                --cta-accent-hover: #075b2a;
                --cta-background: #dfffe7;
                --cta-muted: #496951;
                --cta-text: #092211;
                --gradient-end: #56e98b;
                --gradient-start: #e8ffed;
                --header-background: rgba(7, 19, 12, 0.72);
                --page-glow: rgba(15, 177, 79, 0.18);
                --phone-accent: #27d86c;
                --phone-border: rgba(88, 234, 139, 0.6);
                --phone-muted: #9fd8ad;
                --phone-text: #f4faf5;
                --section-background: #0d2114;
                --section-border: rgba(190, 255, 207, 0.16);
                --section-card: #10251a;
                --section-muted: #5c7162;
                --section-text: #f4faf5;
                --surface: #0b1a11;
                --surface-raised: #172c1d;
                --text: #f4faf5;
                --text-muted: #819689;
                --text-secondary: #b0c1b4;
                --theme-control-background: rgba(190, 255, 207, 0.08);
                --theme-control-border: rgba(190, 255, 207, 0.24);
                --theme-control-hover: rgba(190, 255, 207, 0.14);
                --theme-control-text: #d5e5d8;
                --theme-focus: #65eb95;
                font-family:
                    -apple-system, BlinkMacSystemFont, "SF Pro Display",
                    "Segoe UI", sans-serif;
                background: var(--background);
                color: var(--text);
                line-height: 1.5;
            }

            html[data-theme="light"] {
                color-scheme: light;
                --accent: #087f3e;
                --accent-bright: #0c9850;
                --accent-soft: #0c9850;
                --accent-surface: rgba(12, 152, 80, 0.12);
                --action-text: #f4fff7;
                --background: #f1f7f3;
                --border: #cfe0d3;
                --border-strong: #a7c6ad;
                --card-shadow: 0 18px 42px rgba(27, 85, 45, 0.1);
                --cta-accent: #0c7b38;
                --cta-accent-hover: #075b2a;
                --cta-background: #d8f2df;
                --cta-muted: #45634e;
                --cta-text: #092211;
                --gradient-end: #0c9850;
                --gradient-start: #0d2114;
                --header-background: rgba(241, 247, 243, 0.92);
                --page-glow: rgba(12, 152, 80, 0.15);
                --section-background: #e4f0e7;
                --section-border: #cfe0d3;
                --section-card: #ffffff;
                --section-muted: #466352;
                --section-text: #0d2114;
                --surface: #ffffff;
                --surface-raised: #ffffff;
                --text: #16231b;
                --text-muted: #617768;
                --text-secondary: #425a49;
                --accent-strong: #087f3e;
                --theme-control-background: rgba(12, 127, 62, 0.08);
                --theme-control-border: rgba(12, 127, 62, 0.22);
                --theme-control-hover: rgba(12, 127, 62, 0.14);
                --theme-control-text: #0d2114;
                --theme-focus: #0c9850;
            }

            * {
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                background: var(--background);
                color: var(--text);
                margin: 0;
                min-width: 320px;
                overflow-x: hidden;
                transition:
                    background-color 420ms ease,
                    color 420ms ease;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            a:hover {
                text-decoration: none;
            }

            .page {
                background-color: var(--background);
                background-image: radial-gradient(
                    circle at 80% 2%,
                    var(--page-glow),
                    transparent 30rem
                );
                color: var(--text);
                min-height: 100vh;
                transition:
                    background-color 420ms ease,
                    color 420ms ease;
            }

            .container {
                margin: 0 auto;
                max-width: 1180px;
                padding-left: 28px;
                padding-right: 28px;
            }

            .site-header {
                align-items: center;
                backdrop-filter: blur(18px);
                background: var(--header-background);
                border-bottom: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                left: 0;
                padding: 20px max(28px, calc((100vw - 1180px) / 2));
                position: sticky;
                top: 0;
                transition:
                    background-color 420ms ease,
                    border-color 420ms ease;
                z-index: 10;
            }

            .brand {
                align-items: center;
                display: inline-flex;
                font-size: 1.2rem;
                font-weight: 780;
                gap: 10px;
                letter-spacing: -0.04em;
            }

            .brand-mark {
                background: var(--surface-raised);
                border: 1px solid var(--border-strong);
                border-radius: 10px;
                display: block;
                height: 32px;
                object-fit: cover;
                width: 32px;
            }

            .site-nav {
                align-items: center;
                display: flex;
                font-size: 0.9rem;
                gap: 24px;
            }

            .site-nav a:not(.nav-cta) {
                color: var(--text-secondary);
                transition: color 160ms ease;
            }

            .site-nav a:not(.nav-cta):hover {
                color: var(--text);
            }

            .nav-cta,
            .primary-action {
                background: var(--accent);
                border: 1px solid var(--accent);
                border-radius: 999px;
                color: var(--action-text);
                font-weight: 720;
                transition:
                    background 160ms ease,
                    border-color 160ms ease,
                    transform 160ms ease;
            }

            .nav-cta {
                padding: 10px 16px;
            }

            .nav-cta:hover,
            .primary-action:hover {
                background: var(--accent-bright);
                border-color: var(--accent-bright);
                transform: translateY(-2px);
            }

            .hero {
                align-items: center;
                display: grid;
                gap: 72px;
                grid-template-columns: minmax(0, 1fr) minmax(380px, 0.85fr);
                min-height: 720px;
                padding-bottom: 92px;
                padding-top: 88px;
            }

            .eyebrow {
                align-items: center;
                color: var(--accent-soft);
                display: inline-flex;
                font-size: 0.76rem;
                font-weight: 750;
                gap: 9px;
                letter-spacing: 0.12em;
                text-transform: uppercase;
            }

            .eyebrow::before {
                background: var(--accent);
                border-radius: 50%;
                box-shadow: 0 0 0 5px var(--accent-surface);
                content: "";
                display: inline-block;
                height: 7px;
                width: 7px;
            }

            h1,
            h2,
            h3,
            p {
                margin-top: 0;
            }

            h1,
            h2,
            h3 {
                letter-spacing: -0.055em;
                line-height: 1.05;
            }

            h1 {
                font-size: clamp(3.45rem, 7vw, 6.7rem);
                font-weight: 760;
                letter-spacing: -0.01em;
                margin-bottom: 28px;
                max-width: 700px;
            }

            .gradient-word {
                background: linear-gradient(
                    120deg,
                    var(--gradient-start) 8%,
                    var(--gradient-end) 78%
                );
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }

            .hero-copy > p {
                color: var(--text-secondary);
                font-size: clamp(1.05rem, 2vw, 1.25rem);
                line-height: 1.65;
                margin-bottom: 34px;
                max-width: 570px;
            }

            .actions {
                align-items: center;
                display: flex;
                flex-wrap: wrap;
                gap: 14px;
            }

            .primary-action,
            .secondary-action {
                align-items: center;
                display: inline-flex;
                font-size: 0.96rem;
                justify-content: center;
                padding: 14px 20px;
            }

            .primary-action {
                gap: 6px;
            }

            .secondary-action {
                border: 1px solid var(--border-strong);
                border-radius: 999px;
                color: var(--theme-control-text);
                transition:
                    background 160ms ease,
                    border-color 160ms ease;
            }

            .secondary-action:hover {
                background: var(--theme-control-background);
                border-color: var(--theme-control-border);
            }

            .hero-note {
                color: var(--text-muted);
                font-size: 0.82rem;
                margin: 28px 0 0;
            }

            .hero-visual {
                min-height: 520px;
                position: relative;
            }

            .visual-glow {
                background: var(--accent);
                border-radius: 50%;
                filter: blur(60px);
                height: 170px;
                opacity: 0.24;
                position: absolute;
                right: 32px;
                top: 52px;
                width: 170px;
            }

            .phone-card {
                background: linear-gradient(155deg, #172c1d, #0b1a11 72%);
                border: 1px solid rgba(203, 255, 216, 0.25);
                border-radius: 34px;
                box-shadow:
                    0 30px 90px rgba(0, 0, 0, 0.38),
                    0 0 0 10px rgba(188, 255, 207, 0.035);
                height: 520px;
                overflow: hidden;
                position: absolute;
                right: 34px;
                top: 0;
                transform: rotate(4deg);
                width: min(360px, 82%);
            }

            .phone-card::before {
                background: rgba(255, 255, 255, 0.08);
                border-radius: 0 0 18px 18px;
                content: "";
                height: 24px;
                left: 50%;
                position: absolute;
                top: 0;
                transform: translateX(-50%);
                width: 112px;
                z-index: 2;
            }

            .camera-scene {
                background:
                    linear-gradient(
                        155deg,
                        rgba(20, 45, 29, 0.22),
                        rgba(5, 13, 8, 0.82)
                    ),
                    repeating-linear-gradient(
                        90deg,
                        rgba(169, 255, 191, 0.045) 0 1px,
                        transparent 1px 54px
                    ),
                    linear-gradient(180deg, #3a5b46, #13291b 58%, #08150d);
                height: 100%;
                padding: 58px 20px 20px;
                position: relative;
            }

            .scene-light {
                background: #d7ffca;
                border-radius: 50%;
                box-shadow: 0 0 40px 16px rgba(214, 255, 202, 0.16);
                height: 7px;
                position: absolute;
                top: 96px;
                width: 7px;
            }

            .scene-light.one {
                left: 78px;
            }

            .scene-light.two {
                right: 72px;
                top: 150px;
            }

            .person-shape {
                background: linear-gradient(140deg, #203e2a, #07150c);
                border-radius: 48% 48% 18% 18%;
                bottom: 58px;
                height: 265px;
                left: 50%;
                position: absolute;
                transform: translateX(-50%);
                width: 148px;
            }

            .person-shape::before {
                background: #0a160d;
                border-radius: 50%;
                content: "";
                height: 78px;
                left: 35px;
                position: absolute;
                top: -52px;
                width: 78px;
            }

            .target-tag {
                align-items: center;
                backdrop-filter: blur(12px);
                background: rgba(8, 22, 13, 0.78);
                border: 1px solid var(--phone-border);
                border-radius: 16px;
                box-shadow: 0 12px 30px rgba(0, 0, 0, 0.24);
                display: flex;
                gap: 9px;
                padding: 12px 14px;
                position: absolute;
                z-index: 1;
            }

            .target-tag strong {
                color: var(--phone-text);
                font-size: 0.82rem;
                font-weight: 650;
                white-space: nowrap;
            }

            .target-tag small {
                color: var(--phone-muted);
                display: block;
                font-size: 0.7rem;
                margin-top: 2px;
            }

            .presence-dot {
                background: var(--phone-accent);
                border-radius: 50%;
                box-shadow: 0 0 0 4px rgba(39, 216, 108, 0.12);
                height: 8px;
                width: 8px;
            }

            .target-tag.top {
                left: 24px;
                top: 124px;
            }

            .target-tag.right {
                right: 18px;
                top: 220px;
            }

            .target-tag.bottom {
                bottom: 118px;
                left: 22px;
            }

            .camera-crosshair {
                align-items: center;
                border: 1px solid rgba(232, 255, 237, 0.82);
                border-radius: 50%;
                display: flex;
                height: 36px;
                justify-content: center;
                left: 50%;
                position: absolute;
                top: 55%;
                transform: translate(-50%, -50%);
                width: 36px;
            }

            .camera-crosshair::after {
                background: #f4faf5;
                border-radius: 50%;
                content: "";
                height: 5px;
                width: 5px;
            }

            .phone-status {
                align-items: center;
                color: rgba(244, 250, 245, 0.75);
                display: flex;
                font-size: 0.7rem;
                justify-content: space-between;
                left: 22px;
                position: absolute;
                right: 22px;
                top: 27px;
                z-index: 2;
            }

            .camera-footer {
                align-items: center;
                background: rgba(8, 22, 13, 0.82);
                border: 1px solid rgba(198, 255, 210, 0.12);
                border-radius: 20px;
                bottom: 18px;
                display: flex;
                gap: 8px;
                justify-content: center;
                left: 18px;
                padding: 12px;
                position: absolute;
                right: 18px;
            }

            .camera-footer > span {
                align-items: center;
                color: #8ff2ac;
                display: inline-flex;
                font-size: 0.72rem;
                font-weight: 650;
                gap: 8px;
                letter-spacing: 0.04em;
                text-transform: uppercase;
            }

            .floating-note {
                background: #e3ffe9;
                border-radius: 14px;
                bottom: 44px;
                box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
                color: #0d2a16;
                font-size: 0.78rem;
                font-weight: 700;
                padding: 12px 15px;
                position: absolute;
                right: 0;
                transform: rotate(-6deg);
                z-index: 3;
            }

            .section {
                padding-bottom: 116px;
                padding-top: 116px;
            }

            .light-section {
                background: var(--section-background);
                color: var(--section-text);
                margin-left: calc(50% - 50vw);
                margin-right: calc(50% - 50vw);
                padding-left: max(28px, calc((100vw - 1180px) / 2));
                padding-right: max(28px, calc((100vw - 1180px) / 2));
                transition:
                    background-color 420ms ease,
                    color 420ms ease;
            }

            .section-heading {
                align-items: end;
                display: flex;
                gap: 32px;
                justify-content: space-between;
                margin-bottom: 52px;
            }

            .section-heading h2 {
                font-size: clamp(2.3rem, 5vw, 4rem);
                font-weight: 740;
                margin: 0;
                max-width: 650px;
            }

            .section-heading p {
                color: var(--text-muted);
                margin: 0 0 4px;
                max-width: 310px;
            }

            .light-section .eyebrow {
                color: var(--accent-strong);
            }

            .feature-grid {
                display: grid;
                gap: 16px;
                grid-template-columns: repeat(3, 1fr);
            }

            .feature-card {
                background: var(--section-card);
                border: 1px solid var(--section-border);
                border-radius: 22px;
                min-height: 272px;
                padding: 26px;
                box-shadow: var(--card-shadow);
                transition:
                    border-color 180ms ease,
                    box-shadow 180ms ease,
                    transform 180ms ease,
                    background-color 420ms ease;
            }

            .feature-card:hover {
                border-color: var(--accent-soft);
                box-shadow: 0 18px 42px rgba(34, 101, 53, 0.1);
                transform: translateY(-5px);
            }

            .feature-number {
                color: var(--accent-strong);
                font-size: 0.78rem;
                font-weight: 750;
                letter-spacing: 0.1em;
            }

            .feature-card h3 {
                font-size: 1.55rem;
                font-weight: 700;
                margin: 58px 0 13px;
            }

            .feature-card p {
                color: var(--section-muted);
                margin: 0;
            }

            .product-showcase {
                display: grid;
                gap: 18px;
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .product-shot {
                margin: 0;
                min-width: 0;
            }

            .product-shot-frame {
                background: var(--surface-raised);
                border: 1px solid var(--border);
                border-radius: 28px;
                box-shadow: var(--card-shadow);
                overflow: hidden;
                padding: 10px;
                transition:
                    border-color 180ms ease,
                    box-shadow 180ms ease,
                    transform 180ms ease,
                    background-color 420ms ease;
            }

            .product-shot-frame:hover {
                border-color: var(--accent-soft);
                box-shadow: 0 18px 42px rgba(34, 101, 53, 0.12);
                transform: translateY(-4px);
            }

            .product-shot-frame img {
                border-radius: 20px;
                display: block;
                height: auto;
                width: 100%;
            }

            .product-shot figcaption {
                padding: 18px 4px 0;
            }

            .download-copy strong {
                font-size: 1rem;
                letter-spacing: -0.02em;
            }

            .product-shot figcaption strong {
                display: block;
                font-size: 1.12rem;
                font-weight: 720;
            }

            .product-shot figcaption span {
                color: var(--text-secondary);
                display: block;
                line-height: 1.55;
                margin-top: 5px;
            }

            .story-grid {
                align-items: center;
                display: grid;
                gap: 88px;
                grid-template-columns: 0.8fr 1fr;
            }

            .story-copy h2 {
                font-size: clamp(2.5rem, 5vw, 4.4rem);
                font-weight: 740;
                margin: 18px 0 24px;
            }

            .story-copy p {
                color: var(--text-secondary);
                font-size: 1.08rem;
                line-height: 1.7;
                max-width: 490px;
            }

            .step-list {
                border-top: 1px solid var(--section-border);
                list-style: none;
                margin: 0;
                padding: 0;
            }

            .step {
                align-items: center;
                border-bottom: 1px solid var(--section-border);
                display: flex;
                gap: 22px;
                padding: 23px 0;
            }

            .step-number {
                align-items: center;
                border: 1px solid var(--accent-soft);
                border-radius: 50%;
                color: var(--accent-soft);
                display: inline-flex;
                flex: 0 0 34px;
                font-size: 0.75rem;
                height: 34px;
                justify-content: center;
                width: 34px;
            }

            .step p {
                color: var(--text);
                font-size: 1.08rem;
                margin: 0;
            }

            .cta-section {
                align-items: center;
                background: var(--cta-background);
                border-radius: 30px;
                color: var(--cta-text);
                display: grid;
                gap: 48px;
                grid-template-columns: minmax(0, 1fr) auto;
                overflow: hidden;
                padding: 64px;
                position: relative;
                box-shadow: var(--card-shadow);
                transition:
                    background-color 420ms ease,
                    color 420ms ease;
            }

            .cta-section::after {
                border: 1px solid rgba(13, 79, 33, 0.18);
                border-radius: 50%;
                content: "";
                height: 280px;
                position: absolute;
                right: -55px;
                top: -100px;
                width: 280px;
                z-index: 0;
            }

            .cta-copy,
            .download-card {
                position: relative;
                z-index: 1;
            }

            .download-card {
                align-items: center;
                background: rgba(255, 255, 255, 0.54);
                border: 1px solid rgba(13, 79, 33, 0.16);
                border-radius: 22px;
                display: grid;
                gap: 14px;
                grid-template-columns: 48px minmax(130px, 1fr) 106px;
                max-width: 410px;
                padding: 14px;
            }

            .download-icon {
                border-radius: 14px;
                display: block;
                height: 48px;
                object-fit: cover;
                width: 48px;
            }

            .download-copy {
                display: flex;
                flex-direction: column;
                gap: 2px;
            }

            .download-copy small {
                color: #496951;
                font-size: 0.7rem;
                font-weight: 650;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }

            .download-copy a {
                color: #0c7b38;
                font-size: 0.78rem;
                font-weight: 720;
                margin-top: 4px;
            }

            .qr-link {
                background: #ffffff;
                border-radius: 12px;
                display: block;
                padding: 5px;
                transition: transform 160ms ease;
            }

            .qr-link:hover {
                transform: rotate(2deg) scale(1.03);
            }

            .qr-code {
                display: block;
                height: 96px;
                width: 96px;
            }

            .cta-section h2 {
                font-size: clamp(2.4rem, 5vw, 4.6rem);
                font-weight: 740;
                margin: 0 0 18px;
                max-width: 650px;
                position: relative;
                z-index: 1;
            }

            .cta-section p {
                color: var(--cta-muted);
                font-size: 1.08rem;
                margin: 0 0 28px;
                max-width: 520px;
                position: relative;
                z-index: 1;
            }

            .cta-actions {
                align-items: center;
                display: flex;
                flex-wrap: wrap;
                gap: 20px;
                position: relative;
                z-index: 1;
            }

            .cta-actions .primary-action {
                background: var(--cta-accent);
                border-color: var(--cta-accent);
                color: #f1fff4;
            }

            .cta-actions .primary-action:hover {
                background: var(--cta-accent-hover);
                border-color: var(--cta-accent-hover);
            }

            .cta-actions .text-link {
                color: var(--cta-accent);
                font-weight: 700;
            }

            .site-footer {
                align-items: center;
                border-top: 1px solid var(--border);
                color: var(--text-muted);
                display: flex;
                font-size: 0.86rem;
                gap: 20px;
                justify-content: space-between;
                padding-bottom: 34px;
                padding-top: 26px;
                transition:
                    border-color 420ms ease,
                    color 420ms ease;
            }

            .footer-links {
                display: flex;
                gap: 18px;
            }

            .footer-links a {
                color: var(--text-secondary);
            }

            @media (max-width: 900px) {
                .hero {
                    gap: 32px;
                    grid-template-columns: 1fr;
                    padding-top: 64px;
                }

                .hero-copy {
                    max-width: 720px;
                }

                .hero-visual {
                    margin: 0 auto;
                    max-width: 520px;
                    width: 100%;
                }

                .story-grid {
                    gap: 48px;
                    grid-template-columns: 1fr;
                }

                .product-showcase {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }
            }

            @media (max-width: 700px) {
                .container {
                    padding-left: 20px;
                    padding-right: 20px;
                }

                .site-header {
                    padding-left: 20px;
                    padding-right: 20px;
                }

                .site-nav a:not(.nav-cta) {
                    display: none;
                }

                .theme-toggle {
                    font-size: 0.78rem;
                    min-height: 36px;
                    padding-left: 9px;
                    padding-right: 10px;
                }

                h1 {
                    font-size: clamp(3.1rem, 15vw, 5rem);
                }

                .hero {
                    min-height: 0;
                    padding-bottom: 76px;
                }

                .hero-visual {
                    min-height: 430px;
                }

                .phone-card {
                    height: 430px;
                    right: 16px;
                    width: min(300px, 82%);
                }

                .target-tag.top {
                    left: 12px;
                    top: 98px;
                }

                .target-tag.right {
                    right: 8px;
                    top: 184px;
                }

                .target-tag.bottom {
                    bottom: 92px;
                    left: 10px;
                }

                .person-shape {
                    bottom: 48px;
                    height: 216px;
                    width: 120px;
                }

                .person-shape::before {
                    height: 64px;
                    left: 28px;
                    top: -44px;
                    width: 64px;
                }

                .floating-note {
                    bottom: 20px;
                    right: 0;
                }

                .section {
                    padding-bottom: 78px;
                    padding-top: 78px;
                }

                .light-section {
                    padding-left: 20px;
                    padding-right: 20px;
                }

                .section-heading {
                    align-items: start;
                    flex-direction: column;
                    gap: 18px;
                    margin-bottom: 32px;
                }

                .feature-grid {
                    grid-template-columns: 1fr;
                }

                .product-showcase {
                    grid-template-columns: 1fr;
                }

                .feature-card {
                    min-height: 0;
                }

                .feature-card h3 {
                    margin-top: 38px;
                }

                .cta-section {
                    border-radius: 22px;
                    grid-template-columns: 1fr;
                    padding: 38px 24px;
                }

                .download-card {
                    grid-template-columns: 48px minmax(0, 1fr) 88px;
                    max-width: none;
                }

                .qr-code {
                    height: 78px;
                    width: 78px;
                }

                .site-footer {
                    align-items: flex-start;
                    flex-direction: column;
                    gap: 12px;
                }
            }

            @media (prefers-reduced-motion: reduce) {
                html {
                    scroll-behavior: auto;
                }

                .site-nav a:not(.nav-cta),
                .theme-toggle,
                .nav-cta,
                .primary-action,
                .secondary-action,
                .feature-card,
                .qr-link {
                    transition: none;
                }

                .nav-cta:hover,
                .primary-action:hover,
                .feature-card:hover,
                .qr-link:hover {
                    transform: none;
                }
            }
        </style>
    </head>
    <body>
        <div class="page">
            <header class="site-header">
                <a class="brand" href="/" aria-label="AReach home">
                    <img
                        class="brand-mark"
                        src="/assets/areach-icon.png"
                        alt=""
                    />
                    AReach
                </a>
                <nav class="site-nav" aria-label="Main navigation">
                    <a href="#how-it-works">How it works</a>
                    <a href="/support">Support</a>
                    <ThemeToggle />
                    <a
                        class="nav-cta"
                        href={appStoreUrl}
                        target="_blank"
                        rel="noreferrer">Get the app</a
                    >
                </nav>
            </header>

            <main>
                <section class="hero container" aria-labelledby="hero-title">
                    <div class="hero-copy">
                        <span class="eyebrow"
                            >Social discovery, in the room</span
                        >
                        <h1 id="hero-title">
                            Find your people <span class="gradient-word"
                                >in</span
                            >
                            <span class="gradient-word">the</span>
                            <span class="gradient-word">room.</span>
                        </h1>
                        <p>
                            AReach helps people discover relevant attendees who
                            choose to be visible and start better conversations
                            at live professional events—without turning the room
                            into another endless feed.
                        </p>
                        <div class="actions">
                            <a
                                class="primary-action"
                                href={appStoreUrl}
                                target="_blank"
                                rel="noreferrer"
                            >
                                Download on the App Store <span
                                    aria-hidden="true">↗</span
                                >
                            </a>
                            <a class="secondary-action" href="#how-it-works"
                                >See how it works</a
                            >
                        </div>
                        <p class="hero-note">
                            Invite-only events · Participant-controlled profiles
                            · Built for iPhone
                        </p>
                    </div>

                    <div
                        class="hero-visual"
                        aria-label="Illustration of AReach attendee discovery"
                        role="img"
                    >
                        <div class="visual-glow" aria-hidden="true"></div>
                        <div class="phone-card">
                            <div class="phone-status">
                                <span>9:41</span><span>● ◌ ▰</span>
                            </div>
                            <div class="camera-scene">
                                <div class="scene-light one" aria-hidden="true">
                                </div>
                                <div class="scene-light two" aria-hidden="true">
                                </div>
                                <div class="target-tag top">
                                    <span
                                        class="presence-dot"
                                        aria-hidden="true"></span>
                                    <span
                                        ><strong>Tomi A.</strong><small
                                            >4m away</small
                                        ></span
                                    >
                                </div>
                                <div class="target-tag right">
                                    <span
                                        class="presence-dot"
                                        aria-hidden="true"></span>
                                    <span
                                        ><strong>Sara O.</strong><small
                                            >2m away</small
                                        ></span
                                    >
                                </div>
                                <div class="target-tag bottom">
                                    <span
                                        class="presence-dot"
                                        aria-hidden="true"></span>
                                    <span
                                        ><strong>Daniel K.</strong><small
                                            >6m away</small
                                        ></span
                                    >
                                </div>
                                <div class="person-shape" aria-hidden="true">
                                </div>
                                <div
                                    class="camera-crosshair"
                                    aria-hidden="true"
                                >
                                </div>
                                <div class="camera-footer">
                                    <span
                                        ><span
                                            class="presence-dot"
                                            aria-hidden="true"></span> Live event</span
                                    >
                                </div>
                            </div>
                        </div>
                        <div class="floating-note">Ask me about…</div>
                    </div>
                </section>

                <section
                    class="section light-section"
                    id="how-it-works"
                    aria-labelledby="features-title"
                >
                    <div class="section-heading">
                        <div>
                            <span class="eyebrow"
                                >A different kind of networking</span
                            >
                            <h2 id="features-title">
                                Less searching.<br />More meeting.
                            </h2>
                        </div>
                        <p>
                            Useful context, shown at the moment it can turn into
                            a real conversation.
                        </p>
                    </div>

                    <div class="feature-grid">
                        {
                            features.map((feature) => (
                                <article class="feature-card">
                                    <span class="feature-number">
                                        {feature.number}
                                    </span>
                                    <h3>{feature.title}</h3>
                                    <p>{feature.description}</p>
                                </article>
                            ))
                        }
                    </div>
                </section>

                <section
                    class="section container product-section"
                    aria-labelledby="product-title"
                >
                    <div class="section-heading">
                        <div>
                            <span class="eyebrow">See it in action</span>
                            <h2 id="product-title">
                                From event details to real conversations.
                            </h2>
                        </div>
                        <p>
                            Move from understanding the event to finding the
                            right conversation to start.
                        </p>
                    </div>

                    <div class="product-showcase">
                        <figure class="product-shot">
                            <div class="product-shot-frame">
                                <img
                                    alt="AReach profile editor for sharing attendee interests"
                                    loading="lazy"
                                    src="/assets/product-screens/profile-editor.png"
                                />
                            </div>
                            <figcaption>
                                <strong>Share what matters to you.</strong>
                                <span
                                    >Add concise profile details to help other attendees
                                    find a conversation opening.</span
                                >
                            </figcaption>
                        </figure>

                        <figure class="product-shot">
                            <div class="product-shot-frame">
                                <img
                                    alt="AReach attendees screen showing people currently nearby"
                                    loading="lazy"
                                    src="/assets/product-screens/live-attendees.png"
                                />
                            </div>
                            <figcaption>
                                <strong>See who is visible here.</strong>
                                <span
                                    >Get useful context about the people sharing
                                    the event with you.</span
                                >
                            </figcaption>
                        </figure>

                        <figure class="product-shot">
                            <div class="product-shot-frame">
                                <img
                                    alt="AReach attendee profile details with optional conversation topics"
                                    loading="lazy"
                                    src="/assets/product-screens/attendee-detail-topics.png"
                                />
                            </div>
                            <figcaption>
                                <strong>Find a conversation opening.</strong>
                                <span
                                    >Use profile interests and optional topics to identify
                                    a possible reason to talk.</span
                                >
                            </figcaption>
                        </figure>
                    </div>
                </section>

                <section
                    class="section container"
                    aria-labelledby="story-title"
                >
                    <div class="story-grid">
                        <div class="story-copy">
                            <span class="eyebrow">Designed for the moment</span>
                            <h2 id="story-title">
                                The best profile is the one that gets you
                                talking.
                            </h2>
                            <p>
                                AReach keeps profiles lightweight and
                                event-scoped. Share a headline, add a few things
                                you are happy to talk about, and let the context
                                of the event do the rest.
                            </p>
                        </div>

                        <ol class="step-list" aria-label="How AReach works">
                            {
                                steps.map((step, index) => (
                                    <li class="step">
                                        <span class="step-number">
                                            {String(index + 1).padStart(2, "0")}
                                        </span>
                                        <p>{step}</p>
                                    </li>
                                ))
                            }
                        </ol>
                    </div>
                </section>

                <section class="container section" aria-labelledby="cta-title">
                    <div class="cta-section">
                        <div class="cta-copy">
                            <h2 id="cta-title">
                                Bring a better starting point to your next
                                event.
                            </h2>
                            <p>
                                AReach is being built for focused, human-scale
                                discovery in professional events.
                            </p>
                            <div class="cta-actions">
                                <a
                                    class="primary-action"
                                    href={`mailto:${supportEmail}`}
                                    >Talk to us</a
                                >
                                <a class="text-link" href="/support"
                                    >Get support ↗</a
                                >
                            </div>
                        </div>
                        <div class="download-card">
                            <img
                                class="download-icon"
                                src="/assets/areach-icon.png"
                                alt="AReach app icon"
                            />
                            <div class="download-copy">
                                <small>For iPhone</small>
                                <strong>Get AReach</strong>
                                <a
                                    href={appStoreUrl}
                                    target="_blank"
                                    rel="noreferrer">Open the App Store ↗</a
                                >
                            </div>
                            <a
                                class="qr-link"
                                href={appStoreUrl}
                                target="_blank"
                                rel="noreferrer"
                                aria-label="Scan to open AReach on the App Store"
                            >
                                <img
                                    class="qr-code"
                                    src={appStoreQrUrl}
                                    alt="QR code to open AReach on the App Store"
                                    loading="lazy"
                                    referrerpolicy="no-referrer"
                                />
                            </a>
                        </div>
                    </div>
                </section>
            </main>

            <footer class="site-footer container">
                <span
                    >AReach · Event-scoped social discovery for live
                    professional events.</span
                >
                <nav class="footer-links" aria-label="Footer navigation">
                    <a href="/privacy">Privacy</a>
                    <a href="/terms">Terms</a>
                    <a href="/support">Support</a>
                </nav>
            </footer>
        </div>
    </body>
</html>
