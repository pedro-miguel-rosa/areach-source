{
	"expo": {
		"name": "AReach",
		"slug": "areach",
		"version": "2026.10.1",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "areach",
		"userInterfaceStyle": "automatic",
		"ios": {
			"bundleIdentifier": "com.example.areach",
			"supportsTablet": false,
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false,
				"UIApplicationSceneManifest": {
					"UIApplicationSupportsMultipleScenes": false,
					"UISceneConfigurations": {
						"UIWindowSceneSessionRoleApplication": [
							{
								"UISceneConfigurationName": "Default Configuration",
								"UISceneDelegateClassName": "EXExpoAppSceneDelegate"
							}
						]
					}
				},
				"NSBonjourServices": ["_areach-uwb._tcp"],
				"NSBluetoothAlwaysUsageDescription": "AReach uses Bluetooth to remain discoverable to nearby attendees while a live event is active.",
				"NSCameraUsageDescription": "AReach uses the camera to show the live spatial event camera.",
				"NSLocalNetworkUsageDescription": "AReach uses the local network to find nearby event attendees.",
				"NSNearbyInteractionUsageDescription": "AReach uses Nearby Interaction to show which nearby attendee you are facing.",
				"NSSupportsLiveActivities": true,
				"UIBackgroundModes": ["bluetooth-central", "bluetooth-peripheral", "nearby-interaction"]
			}
		},
		"android": {
			"predictiveBackGestureEnabled": false,
			"package": "com.example.areach"
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#031A14",
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 156
				}
			],
			"expo-image",
			"expo-web-browser",
			"expo-sqlite",
			[
				"expo-widgets",
				{
					"bundleIdentifier": "com.example.areach.widgets",
					"groupIdentifier": "group.com.example.areach",
					"frequentUpdates": true,
					"widgets": []
				}
			],
			"./plugins/withIosBuildWarnings",
			"./plugins/withIosSceneLifecycle",
			"expo-font",
			"expo-secure-store",
			"expo-status-bar"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
